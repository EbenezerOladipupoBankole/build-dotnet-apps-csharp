@ContosoPizza_HostAddress = http://localhost:5166

### Get all pizzas
GET {{ContosoPizza_HostAddress}}/pizza
Accept: application/json

### Get one pizza
GET {{ContosoPizza_HostAddress}}/pizza/3
Accept: application/json

### Create a pizza
POST {{ContosoPizza_HostAddress}}/pizza
Content-Type: application/json

{ "name": "Hawaii", "isGlutenFree": false }

### Update a pizza
PUT {{ContosoPizza_HostAddress}}/pizza/4
Content-Type: application/json

{ "id": 4, "name": "Hawaiian", "isGlutenFree": false }

### Delete a pizza
DELETE {{ContosoPizza_HostAddress}}/pizza/4
